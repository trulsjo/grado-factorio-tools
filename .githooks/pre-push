#!/bin/sh
# Runs scripts/check.ps1 before a push leaves: a parse of every script and every self-test that
# needs neither the game nor the network. With -SkipIfPassed, so a tree that check already passed
# is not run again (grado-factorio-tools#176), but for the glossary step, which reads the commits
# being pushed and can still fail the push (#443); where only the index differs from it, only what
# reads the index runs (#426); its self-tests do not run on a tree that differs from it only in
# whitespace between a script's tokens (#405), and where only scripts and Markdown changed, only
# the changed scripts' self-tests and those of the scripts whose code names a changed file, in
# turn, run (#427). So a push can pass on fewer self-tests than CI runs, which runs every one.
# What each skip shows and cannot see is in that script's header, with what the check does not
# run. This file is only the wiring, as commit-msg is, and is installed by the same one step:
#
#     git config core.hooksPath .githooks
#
# It checks the working tree, not the commits being pushed, so it reads nothing git hands it.
#
# A working tree that is gone stops the push, exit 1, before anything else is tried (#445): git
# runs a hook from the working tree's root, and with no .git there the push cannot succeed, and
# the check would only list failures that do not say why. On 2026-11-13 a linked worktree was
# emptied while its push ran. A tree that goes after this line is the check's to name: its
# closing line says so first.
if [ ! -e "$PWD/.git" ]; then
    echo "pre-push: $PWD has no .git, so it is no working tree; the push stops here." >&2
    exit 1
fi

# The posture on a missing pwsh or a missing check is commit-msg's, for commit-msg's reason: a
# machine that was never going to run the gates is told so and not blocked.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-push: pwsh not found, so the self-tests were NOT run." >&2
    exit 0
fi

CHECK="$(git rev-parse --show-toplevel)/scripts/check.ps1"
if [ ! -f "$CHECK" ]; then
    echo "pre-push: $CHECK not found, so the self-tests were NOT run." >&2
    exit 0
fi

# Git can hand a hook GIT_DIR and its kin, and they outrank `git -C`. pack-mods.ps1's self-test
# builds a scratch repository with `git -C`, so with GIT_DIR set it would stage its fixtures into
# this repository's index. Cleared here, after the last git call this hook makes for itself.
unset $(git rev-parse --local-env-vars)

exec pwsh -NoProfile -File "$CHECK" -SkipIfPassed
