# Build and run output
/dist/
/out/
/tree-viewer-out/
*.zip

# Python
__pycache__/
*.pyc

# Personal, never committed
*.local.md
/.claude/settings.local.json

# Agent runtime state. Ignore the contents rather than the directory, so that
# .omc/skills/ stays committable: project-scoped skills are meant to be shared,
# everything else under .omc/ is this machine's scratch.
/.omc/*
!/.omc/skills/
